<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:baselineAligned="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="4dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="OpenRouter"
        android:src="@drawable/openrouter_logo" />

    <ImageView
        android:layout_width="1dp"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null"
        android:background="@color/widget_divider" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="sans"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="$74.75"
        android:textColor="@color/widget_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="sans"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="누적 충전  $100.50"
        android:textColor="@color/widget_muted"
        android:textSize="14sp" />
</LinearLayout>
